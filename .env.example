# ===========================================================================
# Cobra Commander — configuration
#
# Copy to .env and edit. Real environment variables always override this file,
# so a shell export or a systemd Environment= line wins.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit a key.
# ===========================================================================


# ── Model access (required) ────────────────────────────────────────────────
#
# Cobra Commander talks to any OpenAI-compatible Chat Completions gateway:
# the OpenAI API, an Azure OpenAI deployment, a corporate proxy, a router like
# LiteLLM or OpenRouter, or a local runtime such as Ollama or vLLM.

OPENAI_API_KEY=sk-your-key-here

# API gateway. Must speak POST /v1/chat/completions.
#   OpenAI            https://api.openai.com/v1
#   Local (Ollama)    http://127.0.0.1:11434/v1
#   Router / proxy    https://your-gateway.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model for every agent that does not override it.
OPENAI_MODEL=gpt-5.1

# Optional: keep the key out of plain text. Seal it into .env instead —
#   npx tsx src/core/key-vault.ts <api-key>
# writes CC_VAULT_SALT + CC_WORKER_KEY below. Set a passphrase first for a
# portable seal; without one the seal is tied to this host and user account.
# CC_VAULT_PASSPHRASE=


# ── Per-role model overrides (optional) ────────────────────────────────────
#
# The orchestrator plans and delegates; workers implement. Point them at
# different models to trade cost against capability. Each falls back to the
# OPENAI_* values above.

# ORCHESTRATOR_API_KEY=
# ORCHESTRATOR_BASE_URL=
# ORCHESTRATOR_MODEL=gpt-5.1

# WORKER_API_KEY=
# WORKER_BASE_URL=
# WORKER_MODEL=gpt-5.1

# Comma-separate WORKER_API_KEY to round-robin several keys and ride out 429s.
# WORKER_API_KEY=sk-key-one,sk-key-two

# Requirements-expansion agent (intake).
# INTAKE_API_KEY=
# INTAKE_BASE_URL=
# INTAKE_MODEL=gpt-5.1

# Support agent (diagnosis and repair). Give it a stronger model than the
# factory if you want: it is the one that reads failures for a living.
# DESTRO_PROVIDER=
# DESTRO_MODEL=gpt-5.1
# DESTRO_API_KEY=
# DESTRO_BASE_URL=
# DESTRO_MAX_TURNS=40


# ── Ports and binding ──────────────────────────────────────────────────────
#
# Every listener binds to 127.0.0.1 by default. The API server exposes shell
# and file tools, so do not expose it directly — put an authenticating reverse
# proxy in front of it if it must leave the machine.

API_PORT=4100
REMOTE_PORT=4101
DESTRO_PORT=4102

# CC_BIND_HOST=127.0.0.1
# CC_API_BASE=http://127.0.0.1:4100


# ── Remote control web shell (optional, off by default) ────────────────────

REMOTE_ENABLED=false

# token  — single operator credential from this file (default, portable)
# pam    — authenticate against local system accounts (Linux only)
# cli    — interactive terminal prompt
REMOTE_AUTH_MODE=token

# Generate the hash with:
#   npx tsx src/remote/auth-providers/token.ts <password>
REMOTE_AUTH_USER=operator
# REMOTE_AUTH_PASSWORD_HASH=scrypt$...

# localhost | tailscale | 0.0.0.0 | an explicit address
REMOTE_BIND=localhost
REMOTE_HTTPS=false

REMOTE_MAX_SESSIONS=5
REMOTE_SESSION_TTL=86400
REMOTE_IDLE_TIMEOUT=3600
REMOTE_LOGIN_MAX_ATTEMPTS=5
REMOTE_LOGIN_LOCKOUT_SECONDS=30

# PAM mode only
# REMOTE_PAM_SERVICE=login
# REMOTE_AUTH_ALLOWED_USERS=


# ── Install layout (optional) ──────────────────────────────────────────────
#
# Resolved from the package location by default. Set these only to move state
# somewhere else.

# CC_HOME=/opt/cobra-commander
# CC_ENV_FILE=/etc/cobra-commander/env
# CC_WORKSPACE_ROOT=


# ── Worker safety budgets (optional) ───────────────────────────────────────

# WORKER_TOKEN_BUDGET=
# WORKER_TIME_BUDGET_MS=
# WORKER_TOOL_TIMEOUT_MS=120000
# CC_LLM_REQUEST_TIMEOUT_MS=
# CC_LLM_IDLE_TIMEOUT_MS=

# DESTRO_TOKEN_BUDGET=
# DESTRO_TIME_BUDGET_MS=
# DESTRO_REPEAT_LIMIT=
# DESTRO_EXPLORE_LIMIT=


# ── External security scanner (optional, off by default) ───────────────────
#
# Hand code to a self-hosted AppSec platform and feed findings back to the
# orchestrator. Leave unset and all scanning stays inert.

# SCANNER_API_BASE=https://scanner.example.com
# SCANNER_EMAIL=
# SCANNER_PASSWORD=

# Target a known project instead of find-or-create by name.
# SCANNER_PROJECT_ID=

# Set to 0 to disable the post-delegation auto-scan on orchestrator builds.
# CC_AUTO_SCAN=1

# If the scanner runs in a container whose IP moves, name it and the live
# address is resolved at call time.
# SCANNER_CONTAINER=
# SCANNER_PORT=3000

# Path mapping, when the scanner sees your project at a different path.
# SCANNER_HOST_PATH=/srv/projects
# SCANNER_CONTAINER_PATH=/scan


# ── Web search for the support agent (optional, off by default) ────────────
#
# Backed by a SearXNG instance you run. No default and no third-party
# fallback: with nothing set, the agent's web search is simply unavailable.
# Comma-separated; instances are tried in order.

# SEARXNG_URLS=http://search.internal:8080,http://search-2.internal:8080


# ── Telemetry ──────────────────────────────────────────────────────────────
#
# There is none. No analytics, no usage reporting, no crash reporting — see
# docs/TELEMETRY.md. The only outbound traffic is to the model gateway you
# configure above.
